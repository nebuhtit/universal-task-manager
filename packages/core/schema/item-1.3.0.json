{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-task-manager.dev/schema/item-1.3.0.json",
  "title": "Universal Task Manager item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "createdWithAppId", "createdWithAppName", "createdWithVersion", "revision", "role", "preset", "title", "bodyMarkdown", "state", "createdAt", "updatedAt", "contexts", "tags", "reminders", "relations", "attachments", "custom"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.3.0" },
    "createdWithAppId": { "type": "string" },
    "createdWithAppName": { "type": "string" },
    "createdWithVersion": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "role": { "enum": ["standalone", "series_template", "occurrence"] },
    "preset": { "enum": ["task", "event", "habit", "blank"] },
    "title": { "type": "string" },
    "bodyMarkdown": { "type": "string" },
    "state": { "enum": ["open", "done", "cancelled", "auto_closed", "archived"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "deletedAt": { "type": "string", "format": "date-time" },
    "closure": { "type": "object" },
    "schedule": { "type": "object", "required": ["timezone"] },
    "recurrence": { "type": "object", "required": ["rrule", "rdates", "exdates", "timezone", "closeAt", "anchor", "autoRenew"] },
    "occurrence": { "type": "object", "required": ["seriesId", "recurrenceId", "sequence", "templateRevision"] },
    "recurrenceOverride": { "type": "object", "required": ["kind", "sourceSeriesId", "recurrenceId"], "properties": { "kind": { "enum": ["this_occurrence", "future_split"] }, "sourceSeriesId": { "type": "string" }, "recurrenceId": { "type": "string", "format": "date-time" } } },
    "progress": { "type": "object" },
    "habit": { "type": "object" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 4 },
    "contexts": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "reminders": { "type": "array", "items": { "type": "object" } },
    "relations": { "type": "array", "items": { "type": "object" } },
    "attachments": { "type": "array", "items": { "type": "object" } },
    "custom": { "type": "object" },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
